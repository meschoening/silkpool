#!/bin/sh
# The silkpool package's preremove script (ADR 0013). dpkg runs it with
# "remove" or "upgrade", and rpm with the number of copies there will be,
# 0 on removal. It refuses removal while the machine is enrolled, which
# the running agent answers, then stops and disables the agent, and
# deletes the service account every slot runs as (ADR 0007), while the
# binary is still there. That refuses, and deletes nothing, while a
# process holds the account's UID or the account isn't Silkpool's: then
# it starts the agent again and refuses the removal. An upgrade leaves
# the agent running for the new postinstall to restart.
set -e

case "$1" in
remove | 0) ;;
*) exit 0 ;;
esac

if [ -x /usr/bin/silkpool ]; then
	/usr/bin/silkpool uninstall-check
fi
systemctl disable silkpool.service
if [ -d /run/systemd/system ]; then
	systemctl stop silkpool.service
fi
if [ -x /usr/bin/silkpool ] && ! /usr/bin/silkpool delete-service-account; then
	systemctl enable silkpool.service
	if [ -d /run/systemd/system ]; then
		systemctl start silkpool.service
	fi
	exit 1
fi
