{{/* The frame of every page: the head, which loads the live-update script, the top bar once setup is done and the operator signed in, and the page's main part. A page with live parts marks its body data-stream, so the script opens its stream. */}}
{{define "frame"}}<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<title>{{.Title}} · Silkpool</title>
<link rel="stylesheet" href="/assets/silkpool.css">
<script src="/assets/live.js" defer></script>
</head>
<body{{if .Live}} data-stream{{end}}>
<div class="frame">
{{- if .Tab}}
{{template "nav" .}}
{{- end}}
<main id="main">
{{template "main" .}}
</main>
</div>
</body>
</html>
{{end}}

{{/* The top bar: Nodes, Targets, Activity and Settings, then who's signed in, with Sign out. */}}
{{define "nav"}}<nav class="nav">
<a class="word" href="/">{{template "glyph" (glyph "busy" 16)}}Silkpool</a>
{{- range $tab := tabs}}
<a class="tab" href="{{.Path}}"{{if eq .Name $.Tab}} aria-current="page"{{end}}>{{.Title}}</a>
{{- end}}
<form class="who" method="post" action="/sign-out"><span>{{.Login}}</span><button class="lnk">Sign out</button></form>
</nav>{{end}}

{{/* The logo, for pages without a top bar. */}}
{{define "logo"}}<div class="word logo">{{template "glyph" (glyph "busy" 16)}}Silkpool</div>{{end}}

{{/* A line to copy, such as a runs-on line or a command: the text, and Copy, which the live-update script copies it with. */}}
{{define "copy"}}<div class="copy"><span>{{.}}</span><button class="btn is-sm" type="button" data-copy="{{.}}">Copy</button></div>{{end}}

{{/* History's entries, by day: each day's heading, then its entries, each with its time, its node, unless the list is bare, being one node's, what happened and its origin, and a line that follows. An entry a node reported late carries the ↓ mark; a Degraded episode's start is amber, and Emergency stop red. Activity, a node's page and Nodes list history with it. */}}
{{define "events"}}<ul class="evs{{if .Bare}} is-bare{{end}}">
{{- range .Days}}
<li class="ev-day" data-key="{{.Key}}">{{.Title}}</li>
{{- range .Entries}}
<li class="ev{{with .Tone}} is-{{.}}{{end}}" data-key="{{.Key}}"><time datetime="{{.At}}">{{.Time}}{{with .Late}}<span class="ev-late" title="{{.}}"> ↓</span>{{end}}</time>{{if not $.Bare}}<span class="ev-n">{{if .Path}}<a href="{{.Path}}">{{.Node}}</a>{{else if .Node}}{{.Node}}{{else}}<span class="faint">Hub</span>{{end}}</span>{{end}}<span class="ev-t"><span class="ev-x">{{.Text}}</span>{{with .From}} <span class="ev-o">{{.}}</span>{{end}}{{with .Link}} <a class="lnk" href="{{.}}" rel="noreferrer">View run ↗</a>{{end}}{{with .Detail}}<span class="ev-d">{{.}}</span>{{end}}</span></li>
{{- end}}
{{- end}}
</ul>{{end}}
